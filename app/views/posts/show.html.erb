<% if notice %>
  <div style="color: green; padding: 16px 20px; text-align: center;">
    <%= notice %>
  </div>
<% end %>

<%= render @post %>

<div class="form-container" style="text-align: center;">
  <%= link_to "Edit", edit_post_path(@post), class: "btn" %>
  <%= link_to "Back", posts_path, class: "btn btn-secondary" %>
  <%= link_to "Delete", @post, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-secondary", style: "border-color: #d32f2f; color: #d32f2f;" %>
</div>
