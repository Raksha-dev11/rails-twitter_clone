<div id="<%= dom_id post %>" class="post">
  <div class="post-header">
    <div class="post-avatar"><%= post.user&.email&.first&.upcase || "U" %></div>
    <div class="post-info">
      <div class="post-meta">
        <span class="post-author"><%= post.user&.email&.split('@')&.first || "User" %></span>
        <span class="post-handle">@<%= post.user&.email&.split('@')&.first&.downcase || "user" %></span>
        <span class="post-time"><%= time_ago_in_words(post.created_at) %> ago</span>
      </div>
      <div class="post-content">
        <%= post.text %>
      </div>
      <div class="post-links">
        <%= link_to "View", post, class: "btn btn-secondary" %>
        <%= link_to "Edit", edit_post_path(post), class: "btn btn-secondary" %>
        <%= link_to "Delete", post, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
</div>
