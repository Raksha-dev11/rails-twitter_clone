<div style="max-width: 600px; margin: 0 auto; padding: 40px 20px;">
  <div style="text-align: center; padding: 60px 20px;">
    <h1 style="font-size: 48px; font-weight: bold; color: var(--primary-color); margin-bottom: 16px;">
      𝕏
    </h1>
    <h2 style="font-size: 32px; font-weight: bold; color: var(--text-dark); margin-bottom: 16px;">
      Welcome to Twitter Clone
    </h2>
    <p style="font-size: 18px; color: var(--text-light); margin-bottom: 32px; line-height: 1.6;">
      Share your thoughts, connect with others, and join the conversation. A modern social media experience built with Rails.
    </p>
    
    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 40px;">
      <%= link_to "View Posts Feed", posts_path, class: "btn", style: "font-size: 16px; padding: 12px 32px;" %>
      <%= link_to "Create Your First Post", new_post_path, class: "btn btn-secondary", style: "font-size: 16px; padding: 12px 32px;" %>
    </div>
  </div>

  <div style="border-top: 1px solid var(--border-color); padding-top: 40px;">
    <h3 style="font-size: 20px; font-weight: bold; color: var(--text-dark); margin-bottom: 24px;">Features</h3>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px;">
      <div style="padding: 20px; border: 1px solid var(--border-color); border-radius: 8px; background-color: var(--hover-bg);">
        <div style="font-size: 28px; margin-bottom: 12px;">📝</div>
        <h4 style="font-weight: bold; color: var(--text-dark); margin-bottom: 8px;">Create Posts</h4>
        <p style="color: var(--text-light); font-size: 14px;">Share your thoughts and ideas with the community.</p>
      </div>

      <div style="padding: 20px; border: 1px solid var(--border-color); border-radius: 8px; background-color: var(--hover-bg);">
        <div style="font-size: 28px; margin-bottom: 12px;">📱</div>
        <h4 style="font-weight: bold; color: var(--text-dark); margin-bottom: 8px;">Responsive Design</h4>
        <p style="color: var(--text-light); font-size: 14px;">Works perfectly on desktop, tablet, and mobile devices.</p>
      </div>

      <div style="padding: 20px; border: 1px solid var(--border-color); border-radius: 8px; background-color: var(--hover-bg);">
        <div style="font-size: 28px; margin-bottom: 12px;">⚡</div>
        <h4 style="font-weight: bold; color: var(--text-dark); margin-bottom: 8px;">Fast & Reliable</h4>
        <p style="color: var(--text-light); font-size: 14px;">Built with Rails for speed and stability.</p>
      </div>

      <div style="padding: 20px; border: 1px solid var(--border-color); border-radius: 8px; background-color: var(--hover-bg);">
        <div style="font-size: 28px; margin-bottom: 12px;">🌙</div>
        <h4 style="font-weight: bold; color: var(--text-dark); margin-bottom: 8px;">Dark Mode</h4>
        <p style="color: var(--text-light); font-size: 14px;">Comfortable viewing in any lighting condition.</p>
      </div>

      <div style="padding: 20px; border: 1px solid var(--border-color); border-radius: 8px; background-color: var(--hover-bg);">
        <div style="font-size: 28px; margin-bottom: 12px;">🔐</div>
        <h4 style="font-weight: bold; color: var(--text-dark); margin-bottom: 8px;">Secure</h4>
        <p style="color: var(--text-light); font-size: 14px;">Your data is protected with modern security practices.</p>
      </div>

      <div style="padding: 20px; border: 1px solid var(--border-color); border-radius: 8px; background-color: var(--hover-bg);">
        <div style="font-size: 28px; margin-bottom: 12px;">🚀</div>
        <h4 style="font-weight: bold; color: var(--text-dark); margin-bottom: 8px;">Always Evolving</h4>
        <p style="color: var(--text-light); font-size: 14px;">New features and improvements coming regularly.</p>
      </div>
    </div>
  </div>

  <div style="border-top: 1px solid var(--border-color); margin-top: 40px; padding-top: 40px; text-align: center;">
    <p style="color: var(--text-light); margin-bottom: 20px;">Ready to get started?</p>
    <%= link_to "Go to Posts Feed", posts_path, class: "btn", style: "font-size: 16px; padding: 14px 40px;" %>
  </div>
</div>
